      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Lưu token vào environment\r\nconst res = pm.response.json();\r\nif (res.accessToken) {\r\n    pm.environment.set(\"token\", res.accessToken);\r\n    console.log(\"Token saved!\");\r\n}\r\n\r\n// Test tự động\r\npm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\npm.test(\"Có accessToken\", () => pm.expect(res).to.have.property(\"accessToken\"));\r\npm.test(\"Role là Admin\", () => pm.expect(res.role).to.eql(\"Admin\"));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"admin\",\r\n  \"password\": \"Admin@2026\"\r\n}",
          "options": {
